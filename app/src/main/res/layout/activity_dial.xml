<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/cancel" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/act_phone"
            android:textSize="@dimen/title_normal"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <!-- 超大号码显示区：放得下就居中静止，放不下由 DialActivity 切成左对齐并跑马灯滚动 -->
    <TextView
        android:id="@+id/tvNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_card_round"
        android:padding="16dp"
        android:minHeight="104dp"
        android:gravity="center"
        android:singleLine="true"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:hint="@string/dial_hint"
        android:textColorHint="@color/text_secondary"
        android:textSize="@dimen/title_xlarge"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        tools:text="13800138000" />

    <LinearLayout
        android:id="@+id/keypad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/key1"
                style="@style/DialKey"
                android:text="1" />

            <Button
                android:id="@+id/key2"
                style="@style/DialKey"
                android:text="2" />

            <Button
                android:id="@+id/key3"
                style="@style/DialKey"
                android:text="3" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/key4"
                style="@style/DialKey"
                android:text="4" />

            <Button
                android:id="@+id/key5"
                style="@style/DialKey"
                android:text="5" />

            <Button
                android:id="@+id/key6"
                style="@style/DialKey"
                android:text="6" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/key7"
                style="@style/DialKey"
                android:text="7" />

            <Button
                android:id="@+id/key8"
                style="@style/DialKey"
                android:text="8" />

            <Button
                android:id="@+id/key9"
                style="@style/DialKey"
                android:text="9" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/keyStar"
                style="@style/DialKey"
                android:text="*" />

            <Button
                android:id="@+id/key0"
                style="@style/DialKey"
                android:text="0" />

            <Button
                android:id="@+id/keyHash"
                style="@style/DialKey"
                android:text="#" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <Button
            android:id="@+id/btnDelete"
            style="@style/DialActionKey"
            android:text="@string/dial_delete" />

        <Button
            android:id="@+id/btnClear"
            style="@style/DialActionKey"
            android:text="@string/dial_clear" />
    </LinearLayout>

    <!-- 底部：左边 1/3 是通讯录，右边 2/3 是拨打电话 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:id="@+id/btnContacts"
            android:layout_width="0dp"
            android:layout_height="84dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_contacts_btn"
            android:foreground="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_contacts"
                android:contentDescription="@string/act_contacts" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/act_contacts"
                android:textColor="@color/text_white"
                android:textSize="@dimen/font_normal"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCall"
            android:layout_width="0dp"
            android:layout_height="84dp"
            android:layout_weight="2"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_call_btn"
            android:text="@string/act_phone"
            android:textColor="@color/text_white"
            android:textSize="@dimen/btn_label_xlarge"
            android:textStyle="bold"
            android:stateListAnimator="@null" />
    </LinearLayout>

</LinearLayout>
