<?xml version="1.0" encoding="utf-8"?>
<!--
  主页快捷联系人点一下弹出来的选择框：打电话 / 发短信。
  横排头像很容易在滑动时被误点，所以这里先让用户明确选一次，避免误拨出去。
  左 = 打电话（绿，电话图标），右 = 发短信（蓝，短信图标）；两个按钮都是「图标 + 文字」。
  对话框可点外部区域关闭（代码里显式 setCanceledOnTouchOutside(true)）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="22dp"
    android:paddingEnd="20dp"
    android:paddingBottom="18dp">

    <TextView
        android:id="@+id/tvQuickActionName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/title_normal"
        android:textStyle="bold"
        tools:text="儿子" />

    <TextView
        android:id="@+id/tvQuickActionPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/font_large"
        tools:text="138 0000 0000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="horizontal">

        <!-- 左：打电话 -->
        <LinearLayout
            android:id="@+id/btnQuickCall"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_weight="1"
            android:background="@drawable/bg_call_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/quick_action_call"
                android:src="@drawable/ic_phone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/quick_action_call"
                android:textColor="@android:color/white"
                android:textSize="@dimen/btn_label_large" />
        </LinearLayout>

        <!-- 右：发短信 -->
        <LinearLayout
            android:id="@+id/btnQuickSms"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_contacts_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/quick_action_sms"
                android:src="@drawable/ic_message" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/quick_action_sms"
                android:textColor="@android:color/white"
                android:textSize="@dimen/btn_label_large" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/btnQuickCancel"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_dialog_cancel"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/cancel"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/font_large" />
</LinearLayout>
