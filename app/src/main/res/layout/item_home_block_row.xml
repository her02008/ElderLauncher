<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card_round"
    android:padding="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <ImageView
        android:id="@+id/rowIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no"
        tools:src="@drawable/ic_phone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/font_large"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            tools:text="常用工具" />

        <TextView
            android:id="@+id/rowSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            tools:text="内置功能 · 含 3 个二级功能" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnMoveUp"
        android:layout_width="40dp"
        android:layout_height="44dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_arrow_up"
        android:tint="@color/text_secondary"
        android:scaleType="centerInside"
        android:contentDescription="@string/block_move_up" />

    <ImageButton
        android:id="@+id/btnMoveDown"
        android:layout_width="40dp"
        android:layout_height="44dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_arrow_down"
        android:tint="@color/text_secondary"
        android:scaleType="centerInside"
        android:contentDescription="@string/block_move_down" />

    <ImageButton
        android:id="@+id/btnRemove"
        android:layout_width="40dp"
        android:layout_height="44dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_remove"
        android:tint="@color/text_secondary"
        android:scaleType="centerInside"
        android:contentDescription="@string/block_delete" />

</LinearLayout>
