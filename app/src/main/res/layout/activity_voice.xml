<?xml version="1.0" encoding="utf-8"?>
<!--
  全屏语音页。刻意用深色：这是「一次性动作」的页面，深浅切换本身就是「现在在听你说话」的提示，
  而且深色下白色大字对比度最高，老人看得清。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121A22"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="44dp"
    android:paddingEnd="24dp"
    android:paddingBottom="28dp">

    <TextView
        android:id="@+id/tvVoiceTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/voice_title"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvVoiceHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/voice_hint"
        android:textColor="#8FA3B5"
        android:textSize="16sp" />

    <FrameLayout
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp">

        <ImageView
            android:id="@+id/btnVoiceMic"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_voice_mic"
            android:clickable="true"
            android:contentDescription="@string/voice_tap_to_speak"
            android:focusable="true"
            android:padding="42dp"
            android:src="@drawable/ic_mic" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvVoiceHeard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:minHeight="84dp"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        tools:text="打电话给儿子" />

    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/btnVoiceCancel"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/bg_voice_cancel"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/cancel"
        android:textColor="#FFFFFF"
        android:textSize="20sp" />
</LinearLayout>
