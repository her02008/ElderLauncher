<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFB35C00"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <View
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/fall_act_title"
        android:textColor="#FFFFFF"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/fall_act_sub"
        android:textColor="#FFE0B2"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tvFallState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        tools:text="120 秒后将通知家人" />

    <TextView
        android:id="@+id/tvFallPicked"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/fall_act_picked"
        android:textColor="#FFE0B2"
        android:textSize="15sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <View
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/btnFallOk"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_call_btn"
        android:gravity="center"
        android:text="@string/fall_act_ok"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:text="@string/fall_act_ok_hint"
        android:textColor="#FFE0B2"
        android:textSize="14sp" />
</LinearLayout>
