<?xml version="1.0" encoding="utf-8"?>
<!--
  管理密码页：大键盘 + 大字号，和老人拨号盘同一套按键样式（DialKey / DialActionKey）。
  顶部一行说明当前是「设置 / 确认 / 校验 / 重置」哪种模式，中间显示已输入的位数。
  设置与确认阶段直接显示数字（方便家属核对有没有按错），校验阶段显示圆点（遮挡）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/cancel" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/password_title_bar"
            android:textSize="@dimen/title_normal"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/title_normal"
        android:textStyle="bold"
        tools:text="请输入管理密码" />

    <TextView
        android:id="@+id/tvHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/font_normal"
        tools:text="输入 6 位管理密码，才能修改高级设置" />

    <TextView
        android:id="@+id/tvInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card_round"
        android:padding="16dp"
        android:minHeight="96dp"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/title_xlarge"
        android:textStyle="bold"
        tools:text="●●●●" />

    <TextView
        android:id="@+id/btnForgot"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        android:text="@string/password_forgot"
        android:textColor="@color/btn_contacts"
        android:textSize="@dimen/font_large"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/keypad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/key1"
                style="@style/DialKey"
                android:text="1" />

            <Button
                android:id="@+id/key2"
                style="@style/DialKey"
                android:text="2" />

            <Button
                android:id="@+id/key3"
                style="@style/DialKey"
                android:text="3" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/key4"
                style="@style/DialKey"
                android:text="4" />

            <Button
                android:id="@+id/key5"
                style="@style/DialKey"
                android:text="5" />

            <Button
                android:id="@+id/key6"
                style="@style/DialKey"
                android:text="6" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/key7"
                style="@style/DialKey"
                android:text="7" />

            <Button
                android:id="@+id/key8"
                style="@style/DialKey"
                android:text="8" />

            <Button
                android:id="@+id/key9"
                style="@style/DialKey"
                android:text="9" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/keyStar"
                style="@style/DialKey"
                android:text="*" />

            <Button
                android:id="@+id/key0"
                style="@style/DialKey"
                android:text="0" />

            <Button
                android:id="@+id/keyHash"
                style="@style/DialKey"
                android:text="#" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnDelete"
            style="@style/DialActionKey"
            android:layout_height="76dp"
            android:text="@string/password_delete" />

        <Button
            android:id="@+id/btnOk"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_weight="2"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_call_btn"
            android:text="@string/password_ok"
            android:textColor="@color/text_white"
            android:textSize="@dimen/btn_label_xlarge"
            android:textStyle="bold"
            android:stateListAnimator="@null" />
    </LinearLayout>

</LinearLayout>
