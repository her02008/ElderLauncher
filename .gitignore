# ---------------- Android / Gradle ----------------
.gradle/
build/
app/build/
captures/
*.apk
*.aab
*.ap_
*.dex
*.class
*.hprof
local.properties

# 签名文件永远不要进仓库
*.jks
*.keystore
keystore.properties
signing.properties
# 例外：仓库自带一个**公开密码的测试签名**（signing/elder-launcher.jks）。
# 目的是让「本地构建」和「GitHub Actions 构建」签出来的包签名一致，
# 否则 CI 每次都用随机生成的 debug key，手机上装过旧包就再也盖不上。
# 这个 key 只能用于自己装/test，别用来上架商店；要正式签名请用 signing.properties（见 README）。
!signing/elder-launcher.jks

# ---------------- IDE ----------------
.idea/
*.iml
*.iws
*.ipr
out/
.externalNativeBuild/
.cxx/

# ---------------- 服务端运行时数据 ----------------
# Node 版把 bind/cfg 写在这个目录，含 token，属于私有数据
server/node/data/
server/node/store.json
server/node/store.json.tmp
server/node/.env

# ---------------- 系统垃圾 ----------------
.DS_Store
Thumbs.db
*.log

# ---------------- 工具工作区 ----------------
# .workbuddy 是本地 AI 助手的工作区（会话缓存、项目记忆），属于个人本地数据，一律不入库
.workbuddy/
app/release/
